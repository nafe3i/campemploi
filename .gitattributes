# Normaliser les documents courants entre Windows et les autres systèmes.
* text=auto
*.md text eol=lf
*.txt text eol=lf
.gitignore text eol=lf
.gitattributes text eol=lf

# Les instantanés gardent leurs octets et leurs empreintes d'origine.
tracking/snapshots/** -text
tracking/snapshots/** whitespace=cr-at-eol
